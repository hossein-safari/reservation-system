@startuml
!pragma layout smetana
title Reservation System — PostgreSQL schema
top to bottom direction
hide circle
skinparam shadowing false
skinparam roundcorner 4
skinparam linetype ortho
skinparam defaultFontName SansSerif
skinparam classAttributeIconSize 0
skinparam backgroundColor white
skinparam classBackgroundColor #FAFAF9
skinparam classBorderColor #57534E
skinparam ArrowColor #57534E
skinparam noteBackgroundColor #FFFDF5
skinparam noteBorderColor #A8A29E

' Source: backend/migrations/versions/0001_initial.py
' PostgreSQL physical types; enums use VARCHAR + CHECK, not native PG ENUM.
entity users {
  * id : UUID <<PK>>
  --
  * name : VARCHAR(120)
  * email : VARCHAR(254) <<UQ>>
  * password_hash : VARCHAR(255)
  * role : VARCHAR(8)
  --
  user_role: role IN ('customer', 'admin')
}

entity resources {
  * id : UUID <<PK>>
  --
  * name : VARCHAR(120)
  * description : TEXT
}

entity slots {
  * id : UUID <<PK>>
  --
  * resource_id : UUID <<FK>>
  * starts_at : TIMESTAMPTZ
  * ends_at : TIMESTAMPTZ
  * price_irr : BIGINT
  --
  ck_slot_interval: ends_at > starts_at
  ck_slot_price: price_irr > 0
  INDEX ix_slots_resource_id (resource_id)
  INDEX ix_slots_starts_at (starts_at)
}

entity reservations {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * slot_id : UUID <<FK>>
  * amount_irr : BIGINT
  * status : VARCHAR(9)
  * created_at : TIMESTAMPTZ
  --
  ck_reservation_amount: amount_irr > 0
  reservation_status: status IN
    ('pending', 'confirmed', 'cancelled')
  INDEX ix_reservations_user_id (user_id)
}

entity payments {
  * id : UUID <<PK>>
  --
  * reservation_id : UUID <<FK, UQ>>
  * amount_irr : BIGINT
  * provider_reference : VARCHAR(160) <<UQ>>
  * status : VARCHAR(9)
  * created_at : TIMESTAMPTZ
  --
  ck_payment_amount: amount_irr > 0
  payment_status: status IN ('pending', 'succeeded')
}

entity transactions {
  * id : UUID <<PK>>
  --
  * payment_id : UUID <<FK, UQ>>
  * reference : VARCHAR(160) <<UQ>>
  * amount_irr : BIGINT
  * created_at : TIMESTAMPTZ
  --
  ck_transaction_amount: amount_irr > 0
}

users ||--o{ reservations : user_id
resources ||--o{ slots : resource_id
slots ||--o{ reservations : slot_id / history
reservations ||--o| payments : reservation_id
payments ||--o| transactions : payment_id

note right of slots
  PostgreSQL only: ex_slots_no_overlap
  EXCLUDE USING gist (
    resource_id WITH =,
    tstzrange(starts_at, ends_at, '[)') WITH &&
  )
  Requires btree_gist; adjacent slots are allowed.
end note

note right of reservations
  UNIQUE INDEX uq_active_reservation_slot
  ON reservations (slot_id)
  WHERE status IN ('pending', 'confirmed')

  Many historical reservations per slot;
  at most one active reservation.
  amount_irr stores the booked price snapshot.
end note

legend left
  * = NOT NULL; PK = primary key; FK = foreign key; UQ = UNIQUE
  All foreign keys reference the parent's id; ON DELETE NO ACTION.
  Timestamps are handled as UTC; amounts are integer IRR.
  Technical table (no business relations): alembic_version
  version_num VARCHAR(32) NOT NULL PRIMARY KEY
endlegend
@enduml
