{
  "name": "reservation-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write src package.json tsconfig.json vite.config.ts eslint.config.js",
    "format:check": "prettier --check src package.json tsconfig.json vite.config.ts eslint.config.js"
  },
  "dependencies": {
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/vazirmatn": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
